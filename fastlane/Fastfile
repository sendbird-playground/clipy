require 'shellwords'

PROJECT_ROOT = File.expand_path("..", __dir__)
WORKSPACE_PATH = File.join(PROJECT_ROOT, "Clipy.xcworkspace")
ENTITLEMENTS_PATH = File.join(PROJECT_ROOT, "Clipy", "Clipy.entitlements")

default_platform :mac

platform :mac do

  ############################ PRE ############################

  before_all do
  end

  ######################## SETUP LANES ########################

  desc "Setup development"
  lane :setup do
    Dir.chdir(PROJECT_ROOT) do
      sh "bundle exec pod install"
    end
  end

  ####################### PUBLIC LANES ########################

  desc "Runs all the tests"
  lane :test do
    scan_clipy
  end

  desc "Build a DMG suitable for GitHub releases"
  lane :build_dmg do |options|
    output_name = options[:output_name] || ENV.fetch("OUTPUT_NAME", "Clipy-AppleSilicon")
    build_dir = File.join(PROJECT_ROOT, "build")
    derived_data_path = File.join(build_dir, "DerivedData")
    archive_path = File.join(build_dir, "Clipy.xcarchive")
    release_app_path = File.join(build_dir, "#{output_name}.app")
    release_dmg_path = File.join(build_dir, "#{output_name}.dmg")
    signing_identity = ENV["SIGNING_IDENTITY"].to_s.strip
    signing_identity = "-" if signing_identity.empty?

    sh "rm -rf #{Shellwords.escape(build_dir)}"
    sh "mkdir -p #{Shellwords.escape(build_dir)}"
    sh <<~SH
      set -euo pipefail
      xcodebuild \
        -workspace #{Shellwords.escape(WORKSPACE_PATH)} \
        -scheme Clipy \
        -configuration Release \
        -derivedDataPath #{Shellwords.escape(derived_data_path)} \
        -archivePath #{Shellwords.escape(archive_path)} \
        -destination 'generic/platform=macOS' \
        SKIP_INSTALL=NO \
        CODE_SIGNING_ALLOWED=NO \
        CODE_SIGNING_REQUIRED=NO \
        clean archive
    SH

    built_app_path = File.join(archive_path, "Products", "Applications", "Clipy.app")
    UI.user_error!("Expected build product not found at #{built_app_path}") unless File.directory?(built_app_path)

    sh "ditto #{Shellwords.escape(built_app_path)} #{Shellwords.escape(release_app_path)}"
    sh "/usr/bin/codesign --force --deep --sign #{Shellwords.escape(signing_identity)} --entitlements #{Shellwords.escape(ENTITLEMENTS_PATH)} #{Shellwords.escape(release_app_path)}"
    sh "rm -f #{Shellwords.escape(release_dmg_path)}"
    sh "/usr/bin/hdiutil create -volname #{Shellwords.escape(output_name)} -srcfolder #{Shellwords.escape(release_app_path)} -ov -format UDZO #{Shellwords.escape(release_dmg_path)}"

    UI.message("DMG created at #{release_dmg_path}")
  end

  ####################### PRIVATE LANES ########################

  private_lane :scan_clipy do
    scan(
      workspace: WORKSPACE_PATH,
      scheme: "Clipy",
      verbose: true,
      clean: true
    )
  end

  ############################ POST ############################

  after_all do |lane|
  end

  error do |lane, exception|
  end
end
